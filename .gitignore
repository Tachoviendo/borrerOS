# Kernel source and tarball (se descarga y compila con el script)
kernel/linux-*/
kernel/*.tar.*

# Root filesystem (se genera con debootstrap)
rootfs/

# Disk images
*.img

# ISO build artifacts (se generan con scripts/export_iso.sh)
*.iso
*.squashfs
iso/

# Logs de pruebas en QEMU
qemu-serial.log

# Build artifacts
*.o
*.ko
*.mod
*.mod.c

# Sphinx build output (generado, no se versiona)
docs/build/

# Cache interna de Sphinx
docs/**/.doctrees/
docs/**/*.doctree

# Entorno virtual de Python para Sphinx
docs/venv/
docs/.venv/

# Cache de Python
docs/**/__pycache__/
docs/**/*.pyc
